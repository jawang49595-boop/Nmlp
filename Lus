local dragState
local function makeDraggable(handle, target)
   handle.InputBegan:Connect(function(input)
      if input.UserInputType == Enum.UserInputType.MouseButton1
         or input.UserInputType == Enum.UserInputType.Touch then
         dragState = {target = target, origin = input.Position, start = target.Position}
         input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End
               and dragState and dragState.target == target then
               dragState = nil
            end
         end)
      end
   end)
end
makeDraggable(header, root)
uisConn = UIS.InputChanged:Connect(function(input)
   if dragState and (input.UserInputType == Enum.UserInputType.MouseMovement
      or input.UserInputType == Enum.UserInputType.Touch) then
      local d = input.Position - dragState.origin
      local s = dragState.start
      dragState.target.Position = UDim2.new(s.X.Scale, s.X.Offset + d.X, s.Y.Scale, s.Y.Offset + d.Y)
   end
end)

local function calcScale()
   local cam = workspace.CurrentCamera
   local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
   return math.clamp(math.min((vp.Y - 24) / H, (vp.X - 16) / W, 1), 0.55, 1)
end
