local function parseKg(s)
   if type(s) ~= "string" then return nil end
   local n = s:match("([%d%.]+)%s*[kK][gG]") or s:match("([%d%.]+)%s*กก")
   return n and tonumber(n) or nil
end

local function parsePrice(s)
   if type(s) ~= "string" then return nil end
   local n = s:match("%$%s*([%d,%.]+)")
   if n then
      n = n:gsub(",", "")
      return tonumber(n)
   end
   return nil
end

local function numAttr(inst, keys)
   for k, v in pairs(inst:GetAttributes()) do
      if type(v) == "number" then
         local kl = k:lower()
         for _, key in ipairs(keys) do
            if kl:find(key, 1, true) then return v end
         end
      end
   end
   for _, ch in ipairs(inst:GetChildren()) do
      if ch:IsA("NumberValue") then
         local n = ch.Name:lower()
         for _, key in ipairs(keys) do
            if n:find(key, 1, true) then return ch.Value end
         end
      end
   end
   return nil
end

local infoCache = setmetatable({}, {__mode = "k"})
local function scanText(s, info)
   if type(s) ~= "string" then return end
   if not info.w then info.w = parseKg(s) end
   if not info.v then info.v = parsePrice(s) end
end

local function getInfo(p)
   local c = infoCache[p]
   if c and ((c.w and c.v) or tick() - c.t < 5) then return c end
   local info = {t = tick()}
   scanText(p.ObjectText, info)
   scanText(p.ActionText, info)
   scanText(p.Name, info)
   local node = p
   for depth = 1, 4 do
      if info.w and info.v then break end
      node = node and node.Parent
      if not node or node == workspace then break end
      if not info.w then info.w = numAttr(node, {"weight", "kg", "mass"}) end
      if not info.v then info.v = numAttr(node, {"value", "price", "worth", "cost"}) end
      for _, v in pairs(node:GetAttributes()) do
         if type(v) == "string" then scanText(v, info) end
      end
      for _, ch in ipairs(node:GetChildren()) do
         if ch:IsA("TextLabel") or ch:IsA("TextButton") then scanText(ch.Text, info) end
      end
      if depth <= 1 then
         local n = 0
         for _, d in ipairs(node:GetDescendants()) do
            n = n + 1
            if n > 80 then break end
            if d:IsA("TextLabel") then scanText(d.Text, info) end
         end
      end
   end
   infoCache[p] = info
   return info
end

local FULL_WORDS = {"เต็ม", "full", "100%", "พร้อมเก็บ", "ready"}
local NOT_FULL_WORDS = {"ไม่เต็ม", "ยังไม่", "not full", "notfull", "not ready", "empty", "ถ้วยว่าง", "growing"}
local CUR_KEYS = {"latex", "amount", "fill", "current", "น้ำยาง", "stored"}
local MAX_KEYS = {"max", "capacity", "cap", "limit"}

local function cupStatus(p)
   local texts, flags = {}, {}
   local cur, mx, pct
   local function addText(s)
      if type(s) == "string" and s ~= "" and #s < 80 then table.insert(texts, s:lower()) end
   end
   local function handle(k, v)
      local kl = tostring(k):lower()
      if type(v) == "string" then
         addText(v)
      elseif type(v) == "boolean" then
         if kl:find("full", 1, true) or kl:find("ready", 1, true) or kl:find("เต็ม", 1, true) then
            table.insert(flags, v)
         end
      elseif type(v) == "number" then
         if hasWord(kl, MAX_KEYS) then
            mx = mx or v
         elseif kl:find("percent", 1, true) then
            pct = pct or v
         elseif hasWord(kl, CUR_KEYS) then
            cur = cur or v
         end
      end
   end
   addText(p.ActionText)
   addText(p.ObjectText)
   addText(p.Name)
   local node = p
   for depth = 1, 4 do
      node = node and node.Parent
      if not node or node == workspace then break end
      addText(node.Name)
      for k, v in pairs(node:GetAttributes()) do handle(k, v) end
      for _, ch in ipairs(node:GetChildren()) do
         if ch:IsA("BoolValue") or ch:IsA("NumberValue") or ch:IsA("IntValue") or ch:IsA("StringValue") then
            handle(ch.Name, ch.Value)
         elseif ch:IsA("TextLabel") then
            addText(ch.Text)
         end
      end
      if depth <= 2 then
         local n = 0
         for _, d in ipairs(node:GetDescendants()) do
            n = n + 1
            if n > 80 then break end
            if d:IsA("TextLabel") then addText(d.Text) end
         end
      end
   end
   local blob = table.concat(texts, " | ")
   local summary = blob:sub(1, 90)
   if hasWord(blob, NOT_FULL_WORDS) then return false, summary, true end
   for _, f in ipairs(flags) do
      if f == false then return false, summary, true end
   end
   for _, f in ipairs(flags) do
      if f == true then return true, summary end
   end
   for _, t in ipairs(texts) do
      local a, b = t:match("(%d+)%s*/%s*(%d+)")
      if a and b and tonumber(b) > 0 then
         if tonumber(a) >= tonumber(b) then return true, summary end
         return false, summary, true
      end
   end
   if pct then
      if pct >= 100 then return true, summary end
      return false, summary, true
   end
   if cur and mx and mx > 0 then
      if cur >= mx then return true, summary end
      return false, summary, true
   end
   if hasWord(blob, FULL_WORDS) then return true, summary end
   return false, summary
end

local DURIAN_KEYS = {"durian", "fruit", "harvest", "collect", "pick", "kradum", "thong", "ทุเรียน", "เก็บ"}
local DURIAN_STRONG = {"durian", "kradum", "thong", "ทุเรียน"}
local EXCL = {"plot", "shop", "sell", "buy", "ซื้อ", "คุย", "talk", "ขาย", "rebirth", "job", "market",
   "drive", "ride", "seat", "sit", "vehicle", "board", "enter", "ขับ", "นั่ง", "ขึ้น", "รถ",
   "ปลูก", "กล้า", "sapling", "seed", "เมล็ด", "plant"}

local STIR_WORDS = {"คน", "กวน", "stir", "mix"}
local function promptIsStir(p)
   local own = (p.ActionText .. " " .. p.ObjectText .. " " .. p.Name):lower()
   if own:find("คนอื่น", 1, true) then return false end
   return hasWord(own, STIR_WORDS)
end

local function classify(p)
   local own = (p.Name .. " " .. p.ActionText .. " " .. p.ObjectText):lower()
   if hasWord(own, EXCL) then return nil end
   local text = own
   local par = p.Parent
   for _ = 1, 3 do
      if par and par ~= workspace then
         text = text .. " " .. par.Name:lower()
         par = par.Parent
      end
   end
   local rub = hasWord(text, RUBBER_PROMPT_WORDS) or promptIsStir(p)
   local durStrong = hasWord(text, DURIAN_STRONG)
   local kind
   if rub and not durStrong then
      kind = "rubber"
   else
      if hasWord(text, DURIAN_KEYS) and not (rub and not durStrong) then
         kind = "durian"
      end
   end
   if not kind then return nil end
   if isVehicle(p) or isNpc(p) then return nil end
   return kind
end

local function collectTargets(kind, wantMine)
   local _, root = getChar()
   local list = {}
   local filterW = (kind == "durian" and wantMine) and (S.minW > 0 or S.maxW > 0)
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") and d.Enabled and not (blocked[d] and blocked[d] > tick())
         and classify(d) == kind and amMine(d) == wantMine then
         local info = getInfo(d)
         local w = info.w
         local pass = true
         if filterW then
            if not w then
               pass = false
            else
               if S.minW > 0 and w < S.minW then pass = false end
               if S.maxW > 0 and w > S.maxW then pass = false end
            end
         end
         if pass and kind == "rubber" and not wantMine then
            if promptIsStir(d) or not cupStatus(d) then pass = false end
         end
         local part = promptPart(d)
         if pass and part then
            local dist = root and (root.Position - part.Position).Magnitude or 0
            table.insert(list, {p = d, w = w or 0, v = info.v or w or 0, dist = dist})
         end
      end
   end
   return list
end

local function harvestOne(p)
   local _, root = getChar()
   local part = promptPart(p)
   if not (root and part) then return false end
   local oldHold, oldDist = p.HoldDuration, p.MaxActivationDistance
   pcall(function()
      p.HoldDuration = 0
      p.MaxActivationDistance = 60
      p.RequiresLineOfSight = false
   end)
   for _ = 1, S.retries do
      if not p.Parent or not p.Enabled then return true end
      local _, r = getChar()
      if not r then return false end
      if S.teleport then
         r.CFrame = part.CFrame * CFrame.new(0, 3, 0)
         r.AssemblyLinearVelocity = Vector3.zero
      end
      task.wait(S.settle)
      if fireproximityprompt then pcall(fireproximityprompt, p) end
      if HarvestFruit then pcall(function() HarvestFruit:FireServer(p) end) end
      if CatchReady then pcall(function() CatchReady:FireServer() end) end
      task.wait(0.15)
      if not p.Parent or not p.Enabled or not part.Parent then return true end
   end
   pcall(function()
      p.HoldDuration = oldHold
      p.MaxActivationDistance = oldDist
   end)
   return false
end

local function harvestCycle(kind)
   local _, root = getChar()
   if not root then return end
   local home = root.CFrame
   local did = false
   local list = collectTargets(kind, true)
   table.sort(list, function(a, b)
      if S.sort == "หนักสุดก่อน" then
         if a.w ~= b.w then return a.w > b.w end
      elseif S.sort == "เบาสุดก่อน" then
         if a.w ~= b.w then return a.w < b.w end
      end
      return a.dist < b.dist
   end)
   for _, it in ipairs(list) do
      if not (S.running and S.farmDurian) then break end
      if anySelling() or waterWaiting then break end
      if it.p.Parent and it.p.Enabled then
         if harvestOne(it.p) then
            did = true
         else
            blocked[it.p] = tick() + 15
         end
         task.wait(S.delay)
      end
   end
   local _, r2 = getChar()
   if did and S.teleport and S.returnHome and r2 and not anySelling() and not waterWaiting then
      r2.CFrame = home
   end
end

local function stealOn(kind)
   if kind == "durian" then return S.stealDurian end
   return S.stealRubber
end

