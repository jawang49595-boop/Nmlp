local RUBBER_ITEM_WORDS = {"ขี้ยาง", "น้ำยาง", "ก้อนถ้วย", "ยางก้อน", "cup lump", "cuplump", "lump", "(เสีย)", "(ดิบ)"}
local RUBBER_PROMPT_WORDS = {"rubber", "latex", "cup lump", "cuplump", "lump", "ขี้ยาง", "น้ำยาง", "ก้อนถ้วย", "ยางก้อน", "(เสีย)", "(ดิบ)", "ยาง", "กรีด"}
local SEED_WORDS = {"seed", "เมล็ด", "พันธุ์", "sapling", "ต้นกล้า", "กล้า"}

local function allTools()
   local list = {}
   for _, cont in ipairs({LocalPlayer.Character, LocalPlayer:FindFirstChild("Backpack")}) do
      if cont then
         for _, t in ipairs(cont:GetChildren()) do
            if t:IsA("Tool") then table.insert(list, t) end
         end
      end
   end
   return list
end

local function toolText(t)
   local s = t.Name:lower()
   local ok2, tip = pcall(function() return t.ToolTip end)
   if ok2 and type(tip) == "string" then s = s .. " " .. tip:lower() end
   for _, a in ipairs({"DisplayName", "ItemName", "Type", "ItemType", "Kind"}) do
      local v = t:GetAttribute(a)
      if type(v) == "string" then s = s .. " " .. v:lower() end
   end
   return s
end

local function hasWeight(s)
   return s:find("%d%s*kg") ~= nil or s:find("%d%s*กก") ~= nil
end

local function isRubberTool(t)
   local s = toolText(t)
   if hasWord(s, SEED_WORDS) then return false end
   return hasWord(s, RUBBER_ITEM_WORDS)
end

local function fruitTools()
   local list = {}
   for _, t in ipairs(allTools()) do
      local s = toolText(t)
      if hasWeight(s) and not isRubberTool(t) then table.insert(list, t) end
   end
   return list
end

local function rubberTools()
   local list = {}
   for _, t in ipairs(allTools()) do
      if isRubberTool(t) then table.insert(list, t) end
   end
   return list
end

local function rubberAmount()
   local total, found = 0, false
   for _, t in ipairs(rubberTools()) do
      found = true
      local x = t.Name:match("[xX]%s*(%d+)") or t.Name:match("(%d+)%s*[xX]")
      total = total + (tonumber(x) or 1)
   end
   if found then return total end
   local function scanVals(inst)
      for k, v in pairs(inst:GetAttributes()) do
         if type(v) == "number" and hasWord(k:lower(), RUBBER_ITEM_WORDS) and not hasWord(k:lower(), SEED_WORDS) then
            return v
         end
      end
      for _, ch in ipairs(inst:GetChildren()) do
         if (ch:IsA("IntValue") or ch:IsA("NumberValue"))
            and hasWord(ch.Name:lower(), RUBBER_ITEM_WORDS) and not hasWord(ch.Name:lower(), SEED_WORDS) then
            return ch.Value
         end
      end
      return nil
   end
   local v = scanVals(LocalPlayer)
   if v then return v end
   for _, fn in ipairs({"leaderstats", "Data", "Stats", "PlayerData"}) do
      local f = LocalPlayer:FindFirstChild(fn)
      if f then
         v = scanVals(f)
         if v then return v end
      end
   end
   return 0
end

