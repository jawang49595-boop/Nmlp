local function walkTo(tpos, standoff)
   local _, root0, hum0 = getChar()
   if not root0 then return false end
   local oldSpeed = hum0.WalkSpeed
   local reached = false
   local t0 = tick()
   local lastPos, lastT = root0.Position, tick()
   while S.running and tick() - t0 < 25 do
      local _, r, h = getChar()
      if not r then break end
      h.WalkSpeed = S.walkSpeed
      local flat = Vector3.new(tpos.X - r.Position.X, 0, tpos.Z - r.Position.Z).Magnitude
      if flat <= standoff + 1.5 then reached = true break end
      h:MoveTo(tpos)
      if tick() - lastT > 1 then
         if (r.Position - lastPos).Magnitude < 1.5 then
            if flat <= 8 then reached = true break end
            h.Jump = true
         end
         lastPos, lastT = r.Position, tick()
      end
      task.wait(0.1)
   end
   local _, r, h = getChar()
   if h then
      h.WalkSpeed = oldSpeed
      if r then h:MoveTo(r.Position) end
   end
   return reached
end

