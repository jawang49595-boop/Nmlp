   local function handle(k, v)
      local kl = tostring(k):lower()
      if hasWord(kl, NOT_WATER) then return end
      if type(v) == "string" then
         addText(v)
      elseif type(v) == "boolean" then
         if kl:find("needwater", 1, true) or kl:find("thirst", 1, true) or kl:find("dry", 1, true) then
            table.insert(bools, v)
         elseif kl:find("watered", 1, true) or kl:find("hydrat", 1, true) then
            table.insert(bools, not v)
         end
      elseif type(v) == "number" and hasWord(kl, WATER_KEYS) then
         if hasWord(kl, MAX_KEYS) then
            mx = mx or v
         elseif kl:find("percent", 1, true) then
            pct = pct or v
         else
            cur = cur or v
         end
      end
   end
   for k, v in pairs(plant:GetAttributes()) do handle(k, v) end
   local n = 0
   for _, d in ipairs(plant:GetDescendants()) do
      n = n + 1
      if n > 150 then break end
      if d:IsA("TextLabel") then
         addText(d.Text)
      elseif d:IsA("ProximityPrompt") then
         local pt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
         if hasWord(pt, WATER_ACTION) and not hasWord(pt, RUBBER_ITEM_WORDS) then
            hasPrompt = true
            if d.Enabled then promptOn = true end
         end
      elseif d:IsA("BoolValue") or d:IsA("NumberValue") or d:IsA("IntValue") or d:IsA("StringValue") then
         handle(d.Name, d.Value)
      end
   end
   local blob = table.concat(texts, " | ")
   local summary = cutText(blob, 40)
   local need
   if hasWord(blob, DONE_WORDS) then
      need = false
   else
      local anyTrue, anyFalse = false, false
      for _, b in ipairs(bools) do
         if b then anyTrue = true else anyFalse = true end
      end
      if anyTrue then
         need = true
      elseif anyFalse then
         need = false
      elseif pct then
         need = pct < 100
      elseif cur and mx and mx > 0 then
         need = cur < mx
      elseif hasWord(blob, NEED_WORDS) then
         need = true
      elseif hasPrompt then
         need = promptOn
      end
   end
   return need, summary
end

local function scanPlants()
   local _, root = getChar()
   local found, order = {}, {}
   local function add(plant)
      if not plant or found[plant] then return end
      if Players:GetPlayerFromCharacter(plant) then return end
      if isNpc(plant) or isVehicle(plant) then return end
      if not amMine(plant) then return end
      found[plant] = true
      table.insert(order, plant)
   end
   local function plantOf(inst)
      local node = inst
      local first
      for _ = 1, 8 do
         node = node and node.Parent
         if not node or node == workspace then break end
         if node:IsA("Model") then
            first = first or node
            if hasWord(node.Name:lower(), TREE_WORDS) then return node end
         end
      end
      return first
   end
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") then
         local pt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
         if hasWord(pt, WATER_ACTION) and not hasWord(pt, RUBBER_ITEM_WORDS) and not hasWord(pt, WELL_WORDS) then
            add(plantOf(d))
         end
      elseif d:IsA("Model") then
         for k in pairs(d:GetAttributes()) do
            local kl = k:lower()
            if hasWord(kl, WATER_KEYS) and not hasWord(kl, NOT_WATER) then
               add(d)
               break
            end
         end
      elseif d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 60 then
         if d:FindFirstAncestorOfClass("BillboardGui") or d:FindFirstAncestorOfClass("SurfaceGui") then
            local tl = d.Text:lower()
            if hasWord(tl, WATER_WORDS) and not hasWord(tl, RUBBER_ITEM_WORDS) then add(plantOf(d)) end
         end
      end
   end
   local rows = {}
   for _, pl in ipairs(order) do
      local anc, dup = pl.Parent, false
      while anc and anc ~= workspace do
         if found[anc] then dup = true break end
         anc = anc.Parent
      end
      if not dup then
         local need, sm = plantEval(pl)
         local pv = pl:GetPivot().Position
         table.insert(rows, {pl = pl, need = need, sm = sm, dist = root and (root.Position - pv).Magnitude or 0})
      end
   end
   table.sort(rows, function(a, b) return a.dist < b.dist end)
   return rows
end

local function findThirsty()
   local okc, rows = pcall(scanPlants)
   local targets = {}
   if not okc or not rows then return targets end
   for _, r in ipairs(rows) do
      if r.need == true and not (plantBlock[r.pl] and plantBlock[r.pl] > tick()) then
         table.insert(targets, r)
      end
   end
   return targets
end

local function plantStandPos(plant)
   local pv = plant:GetPivot().Position
   local okb, cf, size = pcall(function() return plant:GetBoundingBox() end)
   local by = (okb and cf) and (cf.Position.Y - size.Y / 2) or pv.Y
   return Vector3.new(pv.X, by + 3, pv.Z), pv
end

local function flyToPlant(plant)
   local target, pv = plantStandPos(plant)
   local _, root = getChar()
   if not root then return false end
   local flat = Vector3.new(root.Position.X - pv.X, 0, root.Position.Z - pv.Z).Magnitude
   if flat > 2.5 then
      if root then root.CFrame = CFrame.new(target) end
   end
   return true
end

local function waterCan()
   for _, t in ipairs(allTools()) do
      local s = toolText(t)
      if hasWord(s, WATER_TOOL_WORDS) and not hasWord(s, SEED_WORDS) and not isRubberTool(t) then
         return t
      end
   end
end

local function canLevel(tool)
   local a, b = tool.Name:match("(%d+)%s*/%s*(%d+)")
   if a then return tonumber(a), tonumber(b) end
   local cur, mx
   for k, v in pairs(tool:GetAttributes()) do
      if type(v) == "number" then
         local kl = k:lower()
         if hasWord(kl, MAX_KEYS) then
            mx = mx or v
         elseif hasWord(kl, {"water", "น้ำ", "fill", "amount", "level", "current", "uses"}) then
            cur = cur or v
         end
      end
   end
   return cur, mx
end

local function waterRemotes(refill)
   local list = {}
   if Remotes then
      for _, r in ipairs(Remotes:GetDescendants()) do
         if r:IsA("RemoteEvent") then
            local n = r.Name:lower()
            if not hasWord(n, NOT_WATER) then
               if refill then
                  if hasWord(n, {"refill", "fill", "well", "pump", "เติม"}) then table.insert(list, r) end
               else
                  if n:find("water", 1, true) and not n:find("fill", 1, true) then table.insert(list, r) end
               end
            end
         end
      end
   end
   return list
end

local function feetPoint()
   local _, root, hum = getChar()
   if not root then return nil end
   return root.Position - Vector3.new(0, hum.HipHeight + root.Size.Y / 2, 0)
end

local function useCanAtFeet(can)
   local aimed = false
   pcall(function()
      local cam = workspace.CurrentCamera
      local fp = feetPoint()
      if not (cam and fp) then return end
      local v, onScreen = cam:WorldToViewportPoint(fp)
      if not onScreen then return end
      VIM:SendMouseMoveEvent(v.X, v.Y, game)
      task.wait(0.1)
      VIM:SendMouseButtonEvent(v.X, v.Y, 0, true, game, 0)
      task.wait(0.05)
      VIM:SendMouseButtonEvent(v.X, v.Y, 0, false, game, 0)
      aimed = true
   end)
   if not aimed then
      pcall(function() can:Activate() end)
   end
end

local function doWater(plant)
   local can = waterCan()
   if can then
      equip(can)
      useCanAtFeet(can)
   end
   for _, d in ipairs(plant:GetDescendants()) do
      if d:IsA("ProximityPrompt") and d.Enabled then
         local pt = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
         if hasWord(pt, WATER_ACTION) and not hasWord(pt, RUBBER_ITEM_WORDS) then triggerPrompt(d) end
      end
   end
   local _, pv = plantStandPos(plant)
   local wr = Remotes and Remotes:FindFirstChild("Water")
   if wr and wr:IsA("RemoteEvent") then
      pcall(function() wr:FireServer("Water", pv) end)
   else
      for _, r in ipairs(waterRemotes(false)) do
         pcall(function() r:FireServer(plant) end)
         pcall(function() r:FireServer(plant, pv) end)
      end
   end
   waterCount = waterCount + 1
end

local wellCache = {t = 0}
local function findWell(force)
   if wellCache.pos and not force and tick() - wellCache.t < 30 then
      return wellCache.pos, wellCache.pr, wellCache.src
   end
   local _, root = getChar()
   local best, bs, bd, bpr, bsrc
   local function consider(pos, pr, score, src)
      if not pos then return end
      local d = root and (pos - root.Position).Magnitude or 0
      if not bs or score > bs or (score == bs and d < bd) then
         best, bs, bd, bpr, bsrc = pos, score, d, pr, src
      end
   end
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") then
         local own = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
         local blob = own .. " " .. ancestorText(d.Parent, 4)
         if hasWord(blob, WELL_WORDS) and not hasWord(blob, SEED_WORDS) and not hasWord(blob, RUBBER_ITEM_WORDS)
            and not classify(d) and not isVehicle(d) and not isNpc(d) then
            local owner = ownerOf(d)
            if not (owner and not amMine(d)) then
               local part = promptPart(d)
               if part then
                  local score = hasWord(own, WELL_ACTION) and 3 or 2
                  if amMine(d) then score = score + 1 end
                  consider(part.Position, d, score, "พรอมต์ '" .. d.ActionText .. "' ที่ " .. (d.Parent and d.Parent.Name or "?"))
               end
            end
         end
      elseif d:IsA("Model") then
         local nl = d.Name:lower()
         if hasWord(nl, {"บ่อน้ำ", "well", "pump", "ปั๊มน้ำ"}) and not isNpc(d) and not isVehicle(d) then
            consider(d:GetPivot().Position, nil, 1, "โมเดล " .. d.Name)
         end
      end
   end
   if best then wellCache = {pos = best, pr = bpr, src = bsrc, t = tick()} end
   return best, bpr, bsrc
end

local function pressRefillButtons()
   local pg = LocalPlayer:FindFirstChild("PlayerGui")
   if not pg then return end
   for _, b in ipairs(pg:GetDescendants()) do
      if b:IsA("GuiButton") and not b:FindFirstAncestor("Rayfield") and isShown(b)
         and b.AbsoluteSize.X > 0 and b.AbsoluteSize.Y > 0 then
         if hasWord(buttonText(b), REFILL_BTN) then
            pressButton(b)
            task.wait(0.3)
         end
      end
   end
end

local function doRefill()
   local pos, pr = findWell(false)
   if not pos then
      note("เติมน้ำ", "ไม่พบบ่อน้ำ")
      task.wait(2)
      return false
   end
   local part = pr and promptPart(pr)
   local tpos = part and part.Position or pos
   local _, root = getChar()
   if not root then return false end
   if root then root.CFrame = CFrame.new(tpos + Vector3.new(0, 3, 0)) end
   task.wait(0.3)
   if pr and pr.Parent then triggerPrompt(pr) end
   pressRefillButtons()
   local can = waterCan()
   if can then
      equip(can)
      pcall(function() can:Activate() end)
   end
   for _, r in ipairs(waterRemotes(true)) do
      pcall(function() r:FireServer() end)
   end
   task.wait(0.5)
   lastRefillT = tick()
   return true
end

local function canEmpty()
   local can = waterCan()
   if can then
      local cur = canLevel(can)
      if cur ~= nil then return cur <= 0 end
   end
   if tick() - lastRefillT > 5 then
      local pg = LocalPlayer:FindFirstChild("PlayerGui")
      if pg then
         for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 60
               and not d:FindFirstAncestor("Rayfield") and guiShown(d) then
               if hasWord(d.Text:lower(), EMPTY_WORDS) then return true end
            end
         end
      end
   end
   return waterCount >= S.waterPerRefill
end

local function waterRound(plant)
   setWaterStatus("กำลังรดน้ำ: " .. plant.Name)
   local pours, refilled = 0, false
   while S.running and S.autoWater and not anySelling() and plant.Parent do
      if canEmpty() then
         setWaterStatus("น้ำหมด กำลังไปเติมน้ำ...")
         if not doRefill() then
            plantBlock[plant] = tick() + 20
            return false
         end
         waterCount = 0
         task.wait(S.refillGap)
         setWaterStatus("กำลังรดน้ำ: " .. plant.Name)
      end
      flyToPlant(plant)
      doWater(plant)
      pours = pours + 1
      task.wait(S.waterDelay)
      if plantEval(plant) ~= true then break end
      if pours == 3 and not refilled then
         refilled = true
         setWaterStatus("ต้นยังไม่หาย ลองเติมน้ำ...")
         doRefill()
         waterCount = 0
         task.wait(S.refillGap)
      elseif pours >= 8 then
         plantBlock[plant] = tick() + 30
         break
      end
   end
   return true
end

