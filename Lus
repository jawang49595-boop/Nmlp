local SELLERS = {
   durian = {label = "ทุเรียน", itemWords = {"durian", "ทุเรียน", "kradum", "fruit"}},
   rubber = {label = "ขี้ยาง", itemWords = {"ขี้ยาง", "น้ำยาง", "ก้อนถ้วย", "cup lump", "cuplump", "lump", "latex"}},
}
local BUY_WORDS = {"sell", "ขาย", "รับซื้อ", "ซื้อ", "คุย", "talk", "merchant", "buyer", "trader", "vendor", "พ่อค้า", "แม่ค้า", "market"}
local SKIP_WORDS = {"plot", "rebirth", "job", "ride", "drive", "sit", "seat", "enter", "board", "ขับ", "นั่ง", "หางาน"}

local function otherKind(k)
   if k == "durian" then return "rubber" end
   return "durian"
end

local function sellerScore(blob, kind)
   local mineHit = hasWord(blob, SELLERS[kind].itemWords)
   local othHit = hasWord(blob, SELLERS[otherKind(kind)].itemWords)
   local s = 0
   if mineHit then s = s + 2 end
   if hasWord(blob, BUY_WORDS) then s = s + 2 end
   if mineHit and blob:find("รับซื้อ", 1, true) then s = s + 2 end
   if othHit and not mineHit then s = s - 3 end
   return s
end

local sellerCache = {}
local function findSeller(kind, force)
   local c = sellerCache[kind]
   if c and not force and tick() - c.t < 20 then return c.pos, c.src end
   local _, root = getChar()
   local best, bs, bd, bsrc
   local function consider(pos, blob, src)
      if not pos then return end
      if hasWord(blob, SEED_WORDS) then return end
      if not hasWord(blob, BUY_WORDS) then return end
      local s = sellerScore(blob, kind)
      if s < 2 then return end
      local d = root and (pos - root.Position).Magnitude or 0
      if not bs or s > bs or (s == bs and d < bd) then best, bs, bd, bsrc = pos, s, d, src end
   end
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") then
         if not classify(d) then
            local blob = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower() .. " " .. ancestorText(d.Parent, 6)
            local part = promptPart(d)
            consider(part and part.Position, blob, "พรอมต์ '" .. d.ActionText .. "' ที่ " .. (d.Parent and d.Parent.Name or "?"))
         end
      elseif d:IsA("Model") then
         if d:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(d) then
            consider(d:GetPivot().Position, d.Name:lower() .. " " .. ancestorText(d.Parent, 2), "NPC " .. d.Name)
         end
      elseif d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 40 then
         local bb = d:FindFirstAncestorOfClass("BillboardGui")
         if bb then
            consider(adorneePos(bb.Adornee or bb.Parent), d.Text:lower() .. " " .. ancestorText(bb.Parent, 3), "ป้าย '" .. d.Text .. "'")
         end
      end
   end
   if best then sellerCache[kind] = {pos = best, src = bsrc, t = tick()} end
   return best, bsrc
end

local function nearestSellPrompt(pos, radius)
   local best, bd
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") and d.Enabled and not classify(d) then
         local part = promptPart(d)
         if part then
            local dist = (part.Position - pos).Magnitude
            if dist <= radius then
               local own = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
               local all = own .. " " .. ancestorText(d.Parent, 6)
               if not hasWord(own, SKIP_WORDS) and not hasWord(all, SEED_WORDS) then
                  if not bd or dist < bd then best, bd = d, dist end
               end
            end
         end
      end
   end
   return best
end

local BTN_ALL = {"sell all", "sell everything", "sell inventory", "ขายทั้งหมด", "ขายหมด"}
local BTN_ANY = {"sell", "ขาย"}

local function isShown(g)
   local node = g
   while node and node ~= game do
      if node:IsA("GuiObject") and not node.Visible then return false end
      if node:IsA("ScreenGui") and not node.Enabled then return false end
      node = node.Parent
   end
   return true
end

local function tooFar()
   local pg = LocalPlayer:FindFirstChild("PlayerGui")
   if not pg then return false end
   for _, d in ipairs(pg:GetDescendants()) do
      if d:IsA("TextLabel") and d.Text ~= "" and #d.Text < 90 and d.TextTransparency < 0.9
         and not d:FindFirstAncestor("Rayfield") then
         local t = d.Text
         if t:find("ใกล้อีก", 1, true) or t:find("เข้ามาใกล้", 1, true) or t:find("ขยับเข้า", 1, true) then
            if isShown(d) then return true end
         end
      end
   end
   return false
end

local function buttonText(b)
   local s = ""
   if b:IsA("TextButton") then s = b.Text end
   local n = 0
   for _, d in ipairs(b:GetDescendants()) do
      n = n + 1
      if n > 10 then break end
      if d:IsA("TextLabel") or d:IsA("TextButton") then s = s .. " " .. d.Text end
   end
   return s:lower()
end

local function rankButtons(kind)
   local pg = LocalPlayer:FindFirstChild("PlayerGui")
   local b1, b2, b3 = {}, {}, {}
   if not pg then return b1 end
   local mineW = SELLERS[kind].itemWords
   local othW = SELLERS[otherKind(kind)].itemWords
   for _, b in ipairs(pg:GetDescendants()) do
      if b:IsA("GuiButton") and not b:FindFirstAncestor("Rayfield") and isShown(b)
         and b.AbsoluteSize.X > 0 and b.AbsoluteSize.Y > 0 then
         local txt = buttonText(b)
         if hasWord(txt, BTN_ANY) and not hasWord(txt, SEED_WORDS) then
            local oth = hasWord(txt, othW)
            if hasWord(txt, mineW) and not oth then
               table.insert(b1, b)
            elseif hasWord(txt, BTN_ALL) and not oth then
               table.insert(b2, b)
            elseif not oth then
               table.insert(b3, b)
            end
         end
      end
   end
   for _, b in ipairs(b2) do table.insert(b1, b) end
   for _, b in ipairs(b3) do table.insert(b1, b) end
   return b1
end

local function pressButton(b)
   if getconnections then
      for _, sig in ipairs({b.MouseButton1Click, b.Activated, b.MouseButton1Down, b.MouseButton1Up}) do
         pcall(function()
            for _, c in ipairs(getconnections(sig)) do c:Fire() end
         end)
      end
   end
   if firesignal then
      pcall(firesignal, b.MouseButton1Click)
      pcall(firesignal, b.Activated)
   end
   pcall(function()
      local ap, as = b.AbsolutePosition, b.AbsoluteSize
      local sg = b:FindFirstAncestorOfClass("ScreenGui")
      local dy = (sg and not sg.IgnoreGuiInset) and GuiService:GetGuiInset().Y or 0
      local x, y = ap.X + as.X / 2, ap.Y + as.Y / 2 + dy
      VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
      task.wait(0.05)
      VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
      VIM:SendTouchEvent(1, 0, x, y)
      task.wait(0.05)
      VIM:SendTouchEvent(1, 2, x, y)
   end)
end

local function sellPromptsNear(kind, radius)
   local _, root = getChar()
   if not root then return end
   for _, d in ipairs(workspace:GetDescendants()) do
      if d:IsA("ProximityPrompt") and not classify(d) then
         local part = promptPart(d)
         if part and (part.Position - root.Position).Magnitude < radius then
            local own = (d.ActionText .. " " .. d.ObjectText .. " " .. d.Name):lower()
            if not hasWord(own, SKIP_WORDS)
               and not hasWord(own .. " " .. ancestorText(d.Parent, 6), SEED_WORDS) then
               local blob = own .. " " .. ancestorText(d.Parent, 6)
               if sellerScore(blob, kind) >= 2 or hasWord(own, BTN_ANY) then
                  triggerPrompt(d)
               end
            end
         end
      end
   end
end

