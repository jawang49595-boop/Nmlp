local sellMemo = {}
local function sellByRemote(kind, cnt)
   local mineW = SELLERS[kind].itemWords
   local othW = SELLERS[otherKind(kind)].itemWords
   local specific, generic = {}, {}
   for _, r in ipairs(Remotes:GetDescendants()) do
      if (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
         local n = r.Name:lower()
         if n:find("sell", 1, true) and not hasWord(n, othW) then
            if hasWord(n, mineW) then table.insert(specific, r) else table.insert(generic, r) end
         end
      end
   end
   local list = {}
   for _, r in ipairs(specific) do table.insert(list, r) end
   for _, r in ipairs(generic) do table.insert(list, r) end
   if #list == 0 then return false end
   local tool = firstTool(kind)
   local pats = {{}, {"All"}, {"all"}, {true}}
   if kind == "durian" then
      table.insert(pats, {"Durian"})
      table.insert(pats, {"Fruit"})
   else
      table.insert(pats, {"Rubber"})
      table.insert(pats, {"Latex"})
   end
   if tool then table.insert(pats, {tool}) end
   local function attempt(r, i)
      local args = pats[i]
      if r:IsA("RemoteFunction") then
         task.spawn(function() pcall(function() r:InvokeServer(unpack(args)) end) end)
      else
         pcall(function() r:FireServer(unpack(args)) end)
      end
      task.wait(0.6)
      if have(kind) < cnt then
         sellMemo[kind] = {r = r, i = i}
         return true
      end
      return false
   end
   local m = sellMemo[kind]
   if m and m.r.Parent and pats[m.i] and attempt(m.r, m.i) then return true end
   for _, r in ipairs(list) do
      for i = 1, #pats do
         if attempt(r, i) then return true end
      end
   end
   return false
end

local strategies = {sellByPrompt, sellByGui, sellByRemote}
local strategyNames = {"พรอมต์ที่พ่อค้า", "ปุ่มขายบนหน้าจอ", "Remote ขาย"}
local preferred = {durian = 1, rubber = 1}

local function trySell(kind, cnt)
   for k = 0, #strategies - 1 do
      local i = ((preferred[kind] - 1 + k) % #strategies) + 1
      if strategies[i](kind, cnt) then
         preferred[kind] = i
         return strategyNames[i]
      end
   end
   return nil
end

local standoffs = {3, 2, 1, 0.5}

local function sellPass(kind)
   local lb = SELLERS[kind].label
   local before = amount(kind)
   if before == nil or before == 0 then
      note("ขาย" .. lb, "ไม่มี" .. lb .. "ในตัว")
      return
   end
   local pos = findSeller(kind, true)
   if not pos then
      note("ขาย" .. lb, "ไม่พบพ่อค้า" .. lb)
      return
   end
   local pr = nearestSellPrompt(pos, 20)
   sellTarget[kind] = pr
   local prPart = pr and promptPart(pr)
   local tpos = prPart and prPart.Position or pos
   note("ขาย" .. lb, "กำลังเดินไปขาย " .. before .. " ชิ้น")

   local used
   for round = 1, #standoffs do
      if not (S.running and sellActive(kind)) then break end
      walkTo(tpos, standoffs[round])
      task.wait(round == 1 and SELL_WAIT or 0.8)

      for _ = 1, 15 do
         if not (S.running and sellActive(kind)) then break end
         local cnt = have(kind)
         if cnt == 0 then break end
         if tooFar() then break end
         local ft = firstTool(kind)
         if ft then equip(ft) end
         local how = trySell(kind, cnt)
         if not how then break end
         used = how
      end

      if have(kind) == 0 then break end
   end

   if used then
      note("ขาย" .. lb, "ขายแล้ว ด้วย: " .. used)
   elseif have(kind) > 0 then
      note("ขาย" .. lb, "ขายไม่สำเร็จ ลองกดใหม่อีกครั้ง")
   end
end

local function startSell(kind)
   if selling[kind] then
      note("ขาย" .. SELLERS[kind].label, "กำลังขายอยู่ รอสักครู่")
      return
   end
   selling[kind] = true
   task.spawn(function()
      local t0 = tick()
      while (cycleBusy or waterStepping) and tick() - t0 < 10 do task.wait(0.1) end
      local okc, err = pcall(sellPass, kind)
      if not okc then warn("sell error:", err) end
      local _, r = getChar()
      if r then pcall(function() r.Anchored = false end) end
      selling[kind] = false
   end)
end

