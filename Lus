local function detectHome()
   local cands = {}
   for _, rootInst in ipairs({workspace, LocalPlayer:FindFirstChild("PlayerGui")}) do
      if rootInst then
         for _, d in ipairs(rootInst:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text:upper():match("^%s*HOME%s*$") then
               local bb = d:FindFirstAncestorOfClass("BillboardGui")
               if bb then
                  local ad = bb.Adornee or bb.Parent
                  local pos = adorneePos(ad)
                  if pos then table.insert(cands, {pos = pos, mine = ad and isMine(ad)}) end
               end
            end
         end
      end
   end
   for _, c in ipairs(cands) do
      if c.mine then return c.pos end
   end
   if #cands > 0 then
      local ref = spawnPos
      if not ref then
         local _, r = getChar()
         ref = r and r.Position
      end
      table.sort(cands, function(a, b)
         if not ref then return false end
         return (a.pos - ref).Magnitude < (b.pos - ref).Magnitude
      end)
      return cands[1].pos
   end
   return nil
end

