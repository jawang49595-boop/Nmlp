local function stealCycle(kind)
   if not isNight() then return end
   local _, root = getChar()
   if not root then return end
   local list = collectTargets(kind, false)
   if #list == 0 then return end
   table.sort(list, function(a, b)
      if a.v ~= b.v then return a.v > b.v end
      return a.dist < b.dist
   end)
   local home = groundBelow(detectHome() or spawnPos or root.Position)
   for _, f in ipairs(list) do
      if not (S.running and stealOn(kind)) then break end
      if not isNight() then break end
      if anySelling() then break end
      if f.p.Parent and f.p.Enabled then
         if kind == "rubber" and not cupStatus(f.p) then
            blocked[f.p] = tick() + 5
         elseif stealOne(f.p) then
            goHome(home)
         else
            blocked[f.p] = tick() + 20
         end
      end
   end
