local function isMine(inst)
   local node = inst
   while node and node ~= workspace do
      if node.Name == LocalPlayer.Name or node.Name == LocalPlayer.DisplayName then return true end
      for _, a in ipairs({"Owner", "OwnerName", "OwnerId", "UserId"}) do
         local v = node:GetAttribute(a)
         if v ~= nil and (v == LocalPlayer.Name or v == LocalPlayer.DisplayName or v == LocalPlayer.UserId) then
            return true
         end
      end
      local ov = node:FindFirstChild("Owner")
      if ov then
         if ov:IsA("ObjectValue") and ov.Value == LocalPlayer then return true end
         if ov:IsA("StringValue") and ov.Value == LocalPlayer.Name then return true end
      end
      node = node.Parent
   end
   return false
end

local function ownerOf(inst)
   local node = inst
   local plotName
   while node and node ~= workspace do
      for _, a in ipairs({"Owner", "OwnerName", "OwnerId", "UserId", "PlayerName"}) do
         local v = node:GetAttribute(a)
         if v ~= nil then
            if type(v) == "number" then
               local pl = Players:GetPlayerByUserId(v)
               if pl then return pl.Name end
            else
               return tostring(v)
            end
         end
      end
      local ov = node:FindFirstChild("Owner")
      if ov then
         if ov:IsA("ObjectValue") and ov.Value then return ov.Value.Name end
         if ov:IsA("StringValue") and ov.Value ~= "" then return ov.Value end
         if ov:IsA("IntValue") or ov:IsA("NumberValue") then
            local pl = Players:GetPlayerByUserId(ov.Value)
            if pl then return pl.Name end
         end
      end
      for _, pl in ipairs(Players:GetPlayers()) do
         if node.Name == pl.Name or node.Name == pl.DisplayName then return pl.Name end
      end
      if not plotName and node.Name:lower():find("plot", 1, true) then plotName = node.Name end
      node = node.Parent
   end
   return nil, plotName
end

local function amMine(d)
   if isMine(d) then return true end
   local owner = ownerOf(d)
   return owner ~= nil and (owner == LocalPlayer.Name or owner == LocalPlayer.DisplayName)
end

