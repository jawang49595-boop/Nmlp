local function goHome(pos)
   local _, r = getChar()
   if r then r.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
   task.wait(HOME_WAIT)
   if CatchReady then pcall(function() CatchReady:FireServer() end) end
